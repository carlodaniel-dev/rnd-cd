---
import { siteConfig } from "../../config/site";

const navigation = [
    { name: "Inicio", href: "/" },
    { name: "Blog", href: "/blog" },
    { name: "Sobre mí", href: "/about" },
    { name: "Contacto", href: "/contact" },
];
---

<header
    class="border-b"
    style="border-color: var(--color-border); background-color: var(--color-surface);"
>
    <nav
        class="mx-auto flex min-h-16 max-w-6xl items-center justify-between px-6"
        aria-label="Navegación principal"
    >
        <a
            href="/"
            class="text-xl font-bold tracking-tight transition-colors"
            style="color: var(--color-text);"
        >
            {siteConfig.name}
        </a>

        <!-- Menú escritorio -->
        <ul class="hidden items-center gap-6 text-sm font-medium md:flex">
            {
                navigation.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class="transition-colors hover:opacity-70"
                            style="color: var(--color-text-muted);"
                        >
                            {item.name}
                        </a>
                    </li>
                ))
            }
        </ul>

        <!-- Botón menú móvil -->
        <button
            id="menu-button"
            type="button"
            class="rounded-md p-2 md:hidden"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-menu"
            style="color: var(--color-text);"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                />
            </svg>
        </button>
    </nav>

    <!-- Menú móvil -->
    <div
        id="mobile-menu"
        class="hidden border-t md:hidden"
        style="border-color: var(--color-border); background-color: var(--color-surface);"
    >
        <ul class="mx-auto max-w-6xl px-6 py-4">
            {
                navigation.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class="block py-3 text-sm font-medium transition-opacity hover:opacity-70"
                            style="color: var(--color-text-muted);"
                        >
                            {item.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</header>

<script>
    const menuButton = document.querySelector("#menu-button");
    const mobileMenu = document.querySelector("#mobile-menu");

    menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";

        menuButton.setAttribute("aria-expanded", String(!isOpen));
        mobileMenu?.classList.toggle("hidden");
    });
</script>