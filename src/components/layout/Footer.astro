---
import { siteConfig } from "../../config/site";
---

<footer
    class="border-t"
    style="border-color: var(--color-border); background-color: var(--color-surface);"
>
    <div
        class="mx-auto flex min-h-20 max-w-6xl flex-col items-center justify-center gap-2 px-6 py-6 text-center"
    >
        <p class="text-sm" style="color: var(--color-text-muted);">
            © {new Date().getFullYear()}
            {siteConfig.name}
        </p>

        <p class="text-xs" style="color: var(--color-text-muted);"></p>
    </div>
</footer>
