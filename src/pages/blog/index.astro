---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../../config/site";

const posts = await getCollection("blog", ({ data }) => !data.draft);

const sortedPosts = posts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);
const galleryPosts = remainingPosts.slice(0, 4);
---

<MainLayout
    title="Blog"
    description="Artículos sobre programación, desarrollo web, aprendizaje y tecnología."
>
    <div class="py-16 sm:py-24">
        <!-- Encabezado -->
        <header class="max-w-3xl">
            <p
                class="text-sm font-medium uppercase tracking-[0.18em]"
                style="color: var(--color-primary);"
            >
                Blog
            </p>

            <h1
                class="mt-4 text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl"
                style="color: var(--color-text);"
            >
                Ideas que estoy aprendiendo
                <span style="color: var(--color-text-muted);">
                    y cosas que vale la pena compartir.
                </span>
            </h1>

            <p
                class="mt-7 max-w-2xl text-lg leading-8"
                style="color: var(--color-text-muted);"
            >
                Escribo sobre programación, desarrollo web, tecnología y
                aprendizajes que voy encontrando en el camino.
            </p>
        </header>

        <!-- Artículo destacado -->
        {
            featuredPost && (
                <section
                    class="mt-20 border-y py-12 sm:mt-24 sm:py-16"
                    style="border-color: var(--color-border);"
                    aria-labelledby="featured-title"
                >
                    <div class="grid gap-8 md:grid-cols-[1fr_2fr] md:gap-16">
                        <div>
                            <p
                                class="text-sm font-medium uppercase tracking-[0.15em]"
                                style="color: var(--color-primary);"
                            >
                                Último artículo
                            </p>
                        </div>

                        <article>
                            <p
                                class="text-sm font-medium"
                                style="color: var(--color-primary);"
                            >
                                {featuredPost.data.category}
                            </p>

                            <h2
                                id="featured-title"
                                class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"
                                style="color: var(--color-text);"
                            >
                                <a
                                    href={`/blog/${featuredPost.id}`}
                                    class="transition-opacity hover:opacity-70"
                                >
                                    {featuredPost.data.title}
                                </a>
                            </h2>

                            <p
                                class="mt-5 max-w-2xl text-base leading-7"
                                style="color: var(--color-text-muted);"
                            >
                                {featuredPost.data.description}
                            </p>

                            <div
                                class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm"
                                style="color: var(--color-text-muted);"
                            >
                                <time
                                    datetime={featuredPost.data.pubDate.toISOString()}
                                >
                                    {featuredPost.data.pubDate.toLocaleDateString(
                                        siteConfig.locale,
                                        {
                                            day: "numeric",
                                            month: "long",
                                            year: "numeric",
                                        },
                                    )}
                                </time>

                                <span aria-hidden="true">·</span>

                                <span>
                                    {featuredPost.data.tags.join(" · ")}
                                </span>
                            </div>

                            <a
                                href={`/blog/${featuredPost.id}`}
                                class="mt-7 inline-flex text-sm font-medium transition-opacity hover:opacity-70"
                                style="color: var(--color-primary);"
                            >
                                Leer artículo →
                            </a>
                        </article>
                    </div>
                </section>
            )
        }

        <!-- Más artículos -->
        {
            remainingPosts.length > 0 && (
                <section
                    class="mt-12 sm:mt-16"
                    aria-labelledby="articles-title"
                >
                    <div class="mb-8">
                        <p
                            class="text-sm font-medium uppercase tracking-[0.15em]"
                            style="color: var(--color-primary);"
                        >
                            Archivo
                        </p>

                        <h2
                            id="articles-title"
                            class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl"
                            style="color: var(--color-text);"
                        >
                            Más artículos
                        </h2>
                    </div>

                    <div
                        class="flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4"
                    >
                        {
                            galleryPosts.map((post) => (
                                <article
                                    class="w-[85%] shrink-0 snap-start rounded-xl border p-6 sm:w-[48%] lg:w-[32%]"
                                    style="border-color: var(--color-border); background-color: var(--color-surface);"
                                >
                                    <p
                                        class="text-sm font-medium"
                                        style="color: var(--color-primary);"
                                    >
                                        {post.data.category}
                                    </p>

                                    <h3
                                        class="mt-3 text-2xl font-semibold leading-tight tracking-tight"
                                        style="color: var(--color-text);"
                                    >
                                        <a
                                            href={`/blog/${post.id}`}
                                            class="transition-opacity hover:opacity-70"
                                        >
                                            {post.data.title}
                                        </a>
                                    </h3>

                                    <p
                                        class="mt-4 text-sm leading-6"
                                        style="color: var(--color-text-muted);"
                                    >
                                        {post.data.description}
                                    </p>

                                    <div class="mt-6 flex items-center justify-between gap-4">
                                        <time
                                            class="text-sm"
                                            datetime={post.data.pubDate.toISOString()}
                                            style="color: var(--color-text-muted);"
                                        >
                                            {post.data.pubDate.toLocaleDateString(
                                                siteConfig.locale,
                                                {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric",
                                                },
                                            )}
                                        </time>

                                        <a
                                            href={`/blog/${post.id}`}
                                            class="text-sm font-medium transition-opacity hover:opacity-70"
                                            style="color: var(--color-primary);"
                                        >
                                            Leer →
                                        </a>
                                    </div>
                                </article>
                            ))
                        }

                        <!-- Botón: Ver todos --> 
                        <div class="flex w-[85%] shrink-0 snap-start items-center justify-center sm:w-auto"> 
                            <a href="/blog" class="inline-flex items-center gap-2 rounded-lg border px-5 py-3 text-sm font-medium transition-colors hover:bg-slate-100" style="border-color: var(--color-border); color: var(--color-primary);" > Ver todos<span aria-hidden="true">→</span> </a> 
                        </div>
                    </div>
                </section>
            )
        }

        <!-- Estado sin artículos adicionales -->
        {
            sortedPosts.length === 1 && (
                <section
                    class="mt-20 border-t pt-12 text-center sm:mt-24"
                    style="border-color: var(--color-border);"
                >
                    <p class="text-sm" style="color: var(--color-text-muted);">
                        Este es el comienzo. Pronto habrá más artículos.
                    </p>
                </section>
            )
        }
    </div>
</MainLayout>
