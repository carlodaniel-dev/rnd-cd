---
import MainLayout from "../layouts/MainLayout.astro";
import { siteConfig } from "../config/site";
---

<MainLayout title={siteConfig.title} description={siteConfig.description}>
    <div class="space-y-32 py-16 sm:py-24">

        <!-- Hero -->
        <section
            class="flex min-h-[calc(100vh-18rem)] items-center"
            aria-labelledby="hero-title"
        >
            <div class="max-w-4xl">
                <p class="eyebrow mb-6">
                    Carlos Daniel
                </p>

                <h1
                    id="hero-title"
                    class="text-main max-w-4xl text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl"
                >
                    Desarrollador que aprende,&nbsp;
                    <span class="text-muted">
                        reflexiona y comparte.
                    </span>
                </h1>

                <p class="text-muted mt-8 max-w-2xl text-lg leading-8 sm:text-xl">
                    Un espacio personal donde escribo sobre programación,
                    desarrollo web, tecnología y todo aquello que voy
                    aprendiendo en el camino.
                </p>

                <div class="mt-10 flex flex-wrap items-center gap-4">
                    <a
                        href="/blog"
                        class="button-primary inline-flex"
                    >
                        Explorar artículos
                    </a>

                    <a
                        href="/about"
                        class="inline-flex rounded-lg border px-5 py-3 text-sm font-medium transition-colors hover:bg-white/5"
                        style="border-color: var(--color-border); color: var(--color-text);"
                    >
                        Sobre mí
                    </a>
                </div>
            </div>
        </section>

        <!-- Introducción -->
        <section
            class="border-y border-default py-16 sm:py-20"
            aria-labelledby="about-preview-title"
        >
            <div class="grid gap-10 md:grid-cols-[1fr_2fr] md:gap-16">
                <div>
                    <p class="eyebrow">
                        Sobre este espacio
                    </p>
                </div>

                <div>
                    <h2
                        id="about-preview-title"
                        class="text-main text-2xl font-semibold tracking-tight sm:text-3xl"
                    >
                        Aprender también es compartir.
                    </h2>

                    <p class="text-muted mt-5 max-w-2xl text-base leading-7">
                        Este blog nace como un espacio para documentar mi
                        aprendizaje, explorar nuevas ideas y compartir aquello
                        que considero útil dentro del mundo de la tecnología.
                    </p>

                    <p class="text-muted mt-4 max-w-2xl text-base leading-7">
                        No busco tener todas las respuestas. Busco entender
                        mejor las cosas, escribir sobre ellas y seguir creciendo
                        como desarrollador.
                    </p>
                </div>
            </div>
        </section>

        <!-- Temas -->
        <section aria-labelledby="topics-title">
            <div class="mb-10">
                <p class="eyebrow">
                    Contenido
                </p>

                <h2
                    id="topics-title"
                    class="text-main mt-3 text-3xl font-semibold tracking-tight sm:text-4xl"
                >
                    Temas que encontrarás aquí
                </h2>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <article class="surface-card transition-transform hover:-translate-y-0.5">
                    <h3 class="text-main font-semibold">
                        Programación
                    </h3>

                    <p class="text-muted mt-3 text-sm leading-6">
                        Conceptos, herramientas y aprendizajes relacionados con
                        el desarrollo de software.
                    </p>
                </article>

                <article class="surface-card transition-transform hover:-translate-y-0.5">
                    <h3 class="text-main font-semibold">
                        Desarrollo web
                    </h3>

                    <p class="text-muted mt-3 text-sm leading-6">
                        Tecnologías, buenas prácticas y experiencias
                        construyendo para la web.
                    </p>
                </article>

                <article class="surface-card transition-transform hover:-translate-y-0.5">
                    <h3 class="text-main font-semibold">
                        Aprendizaje
                    </h3>

                    <p class="text-muted mt-3 text-sm leading-6">
                        Reflexiones, experiencias y lecciones aprendidas durante
                        mi crecimiento profesional.
                    </p>
                </article>

                <article class="surface-card transition-transform hover:-translate-y-0.5">
                    <h3 class="text-main font-semibold">
                        Tecnología
                    </h3>

                    <p class="text-muted mt-3 text-sm leading-6">
                        Ideas, herramientas y temas que despiertan mi curiosidad
                        dentro del mundo tecnológico.
                    </p>
                </article>
            </div>
        </section>

        <!-- CTA -->
        <section
            class="border-t border-default pt-16 text-center sm:pt-20"
        >
            <h2
                class="text-main text-2xl font-semibold tracking-tight sm:text-3xl"
            >
                ¿Quieres leer lo que estoy aprendiendo?
            </h2>

            <p class="text-muted mx-auto mt-4 max-w-xl text-base leading-7">
                Explora los artículos y acompáñame en este proceso de
                aprendizaje continuo.
            </p>

            <a
                href="/blog"
                class="button-primary mt-8 inline-flex"
            >
                Ver artículos
            </a>
        </section>

    </div>
</MainLayout>
